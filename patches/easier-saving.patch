+// save to the current slot without opening the menu (sleep/power-off and low battery)
+static int Menu_saveCurrentSlot(void) {
+	Menu_updateState();
+
+	if (menu.total_discs) {
+		char* disc_path = menu.disc_paths[menu.disc];
+		putFile(menu.txt_path, disc_path + strlen(menu.base_path));
+	}
+
+	// the device may power off right after this so write the preview synchronously
+	if (menu.bitmap) { // in the menu, the game frame was captured on open
+		SDL_RWops* rw = SDL_RWFromFile(menu.bmp_path, "wb");
+		if (rw) IMG_SavePNG_RW(menu.bitmap, rw, 1);
+	}
+	else {
+		int cw, ch;
+		SaveImageArgs* args = malloc(sizeof(SaveImageArgs));
+		args->pixels = (char*)GFX_GL_screenCapture(&cw, &ch);
+		args->w = cw;
+		args->h = ch;
+		args->path = SDL_strdup(menu.bmp_path);
+		SDL_WaitThread(screenshotsavethread, NULL);
+		screenshotsavethread = NULL;
+		save_screenshot_thread(args);
+	}
+	newScreenshot = 0;
+
+	state_slot = menu.slot;
+	putInt(menu.slot_path, menu.slot);
+	return State_write();
+}
+// sleep/power-off quicksave into the current slot instead of the hidden auto slot
+static void Menu_quicksaveToSlot(void) {
+	Menu_saveCurrentSlot();
+	putInt(ES_RESUME_SLOT_PATH, menu.slot);
+}
+// called every frame in game: save at 10% and 5% battery, then every 2 minutes until charging
+#define LOW_BATTERY_FIRST 10
+#define LOW_BATTERY_LAST 5
+#define LOW_BATTERY_REPEAT_MS (2 * 60 * 1000)
+void Menu_checkLowBattery(void) {
+	static uint32_t checked_at = 0;
+	static uint32_t saved_at = 0;
+	static int saved_charge = 101; // charge at the last low battery save
+
+	if (!ES_get(ES_LOW_BATTERY_SAVE)) return;
+
+	uint32_t now = SDL_GetTicks();
+	if (checked_at && now - checked_at < 5000) return; // the battery is only polled every few seconds anyway
+	checked_at = now;
+
+	if (PWR_isCharging()) {
+		saved_charge = 101;
+		return;
+	}
+
+	int charge = PWR_getBattery();
+	int due = (charge <= LOW_BATTERY_FIRST && saved_charge > LOW_BATTERY_FIRST)
+	       || (charge <= LOW_BATTERY_LAST && saved_charge > LOW_BATTERY_LAST)
+	       || (charge <= LOW_BATTERY_LAST && now - saved_at >= LOW_BATTERY_REPEAT_MS);
+	if (!due || RA_isHardcoreModeActive()) return;
+
+	saved_charge = charge;
+	saved_at = now;
+	LOG_info("low battery (%i%%), saving to slot %i\n", charge, menu.slot);
+	int success = Menu_saveCurrentSlot();
+
+	char msg[NOTIFICATION_MAX_MESSAGE];
+	snprintf(msg, sizeof(msg), success ? "Low Battery - Saved to Slot %d" : "Low Battery - Save Failed", menu.slot + 1);
+	Notification_push(NOTIFICATION_SAVE_STATE, msg, NULL);
+}
 
