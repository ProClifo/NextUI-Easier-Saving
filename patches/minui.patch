+// called from input polling during play: save to the current slot once the
+// battery reaches its lowest reading (MinUI reports 10% steps), then every
+// 2 minutes until charging
+#define LOW_BATTERY_CHARGE 10
+#define LOW_BATTERY_REPEAT_MS (2 * 60 * 1000)
+static void Menu_checkLowBattery(void) {
+	static uint32_t checked_at = 0;
+	static uint32_t saved_at = 0;
+	static int saved = 0; // already saved since the charge dropped
+
+	if (!ES_get(ES_LOW_BATTERY_SAVE)) return;
+
+	uint32_t now = SDL_GetTicks();
+	if (checked_at && now - checked_at < 5000) return; // the battery is only polled every few seconds anyway
+	checked_at = now;
+
+	if (PWR_isCharging() || PWR_getBattery() > LOW_BATTERY_CHARGE) {
+		saved = 0;
+		return;
+	}
+	if (saved && now - saved_at < LOW_BATTERY_REPEAT_MS) return;
+
+	saved = 1;
+	saved_at = now;
+	LOG_info("low battery (%i%%), saving to slot %i\n", PWR_getBattery(), menu.slot);
+	Menu_saveState();
+}
+
+// called from input polling during play: save to the current slot every Save Interval of play
+static uint32_t interval_saved_at = 0; // 0 restarts the interval, eg. after the menu
+static void Menu_checkSaveInterval(void) {
+	int secs = ES_save_interval_secs[ES_get(ES_SAVE_INTERVAL)];
+	uint32_t now = SDL_GetTicks();
+	if (!secs || !interval_saved_at) {
+		interval_saved_at = now;
+		return;
+	}
+	if (now - interval_saved_at < (uint32_t)secs * 1000) return;
+	interval_saved_at = now;
+
+	LOG_info("save interval (%is), saving to slot %i\n", secs, menu.slot);
+	Menu_saveState();
+}
